{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceState 0.1",
  "type": "object",
  "required": [
    "binding_id",
    "status",
    "observed_at",
    "expires_at"
  ],
  "properties": {
    "binding_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "available",
        "unavailable",
        "unverified"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "details": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
